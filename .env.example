# ========================
# 🌐 Application Environment
# ========================

# Defines the current application environment: development | testing | production
APP_ENV=development

# Base path if the app is running in a subdirectory (e.g. /myapp)
BASE_PATH=/php-mini-mvc

# Reverse proxies whose X-Forwarded-Host / X-Forwarded-Proto headers may be trusted when building
# absolute URLs (site_url(), redirects). Comma-separated IPs or CIDR blocks, e.g. 127.0.0.1,10.0.0.0/8;
# "*" trusts every connection (only when the app is reachable exclusively through such a proxy).
# Empty: forwarded headers are ignored.
TRUSTED_PROXIES=

# Default language used by the application (e.g. en, pt-br)
DEFAULT_LANGUAGE=en

# Token required by protected system API routes such as /api-system/i18n, and by the framework
# documentation at /web-system outside development (X-System-Token header, Authorization: Bearer,
# or ?system_token= in the browser). Leave empty to disable both outside development.
# Vue pages that fetch translations directly will receive this token in browser boot data.
# Use it only for framework utility endpoints, not private user data.
SYSTEM_TOKEN=

# System helpers autoload strategy:
# - true: loads all helpers inside system/helpers (default)
# - ['response','view.php']: loads only listed helpers (with or without .php)
# - false: loads no system helpers; framework runtime uses static classes directly
SYSTEM_HELPERS_AUTOLOAD=true

# App helpers autoload strategy:
# - true: loads all helpers inside app/helpers (default)
# - ['my_helper','other_helper.php']: loads only listed helpers (with or without .php)
APP_HELPERS_AUTOLOAD=true

# Not currently used by the framework core, but useful when working with encrypted files or sensitive texts.
# If you are interested, check the Security class from: vitor-delgallo/PHPHelper
APP_KEY=

# ========================
# 🧠 Sessions
# ========================

# Session driver: files | db | none
# - files: uses native PHP file-based sessions
# - db: stores session data in the database
# - none: disables session handling
SESSION_DRIVER=none

# Named database connection used by SESSION_DRIVER=db (leave blank to use the default DB_* connection)
SESSION_DB=

# Optional prefix for session keys (used when SESSION_DRIVER=db)
SESSION_PREFIX=

# Optional encryption key for DB-backed session data at rest.
# Leave blank to store DB session payloads without encryption.
# When filled, use at least 32 random characters; example generator:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Encrypted DB sessions use a v2 authenticated format. Clear old encrypted session rows after upgrading from older framework versions.
SESSION_ENCRYPT_KEY=

# ========================
# 🗄️ Database
# ========================

# Database driver: mysql | pgsql | none
DB_DRIVER=none

# Database host (e.g. localhost, 127.0.0.1)
DB_HOST=

# Database port (leave blank to use the default port for the selected driver)
DB_PORT=

# Name of the database to connect to
DB_NAME=

# Username for database authentication
DB_USER=

# Password for the specified database user
DB_PASS=

# Charset used in the database connection (e.g. utf8, utf8mb4)
DB_CHARSET=utf8

# Optional named database connections:
# - Use any uppercase suffix after DB_*_ (e.g. APP, AUTH, ROBOT)
# - Required per suffix: DRIVER, HOST, NAME, USER
# - Optional per suffix: PASS, PORT, CHARSET
# - Access DB_*_APP as connection name "app", DB_*_AUTH as "auth", etc.
DB_DRIVER_APP=
DB_HOST_APP=
DB_PORT_APP=
DB_NAME_APP=
DB_USER_APP=
DB_PASS_APP=
DB_CHARSET_APP=
