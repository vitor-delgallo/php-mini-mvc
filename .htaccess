###############################################
# 🌐 Enable mod_rewrite for friendly URLs
###############################################
RewriteEngine On

###############################################
# 🌐 Redirect www to the bare domain (one canonical host for SEO)
###############################################
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [R=301,L]

###############################################
# 🔒 Block access to hidden files (.env, .git, etc.)
###############################################
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

###############################################
# 🔒 Block access to sensitive file types
###############################################
<FilesMatch "\.(env|ini|log|sh|bak|sql|dist|pem|crt|key|tpl|lock|json|yml)$">
  Require all denied
</FilesMatch>

###############################################
# 🔒 Disable directory listing (prevent file exposure)
###############################################
Options -Indexes

###############################################
# ✅ Allow direct access to /public assets
###############################################
RewriteCond %{REQUEST_URI} ^/public/
RewriteRule .* - [L]

###############################################
# 📏 Remove trailing slashes from URLs (for cleaner SEO)
###############################################
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

###############################################
# 🔒 Never serve application code, framework, storage, vendor or source files directly
###############################################
RewriteRule ^(app|system|storage|vendor|resources|node_modules)(/|$) - [F,L]

###############################################
# 🔁 Route all other requests to index.php (for central routing)
###############################################
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ public/index.php [QSA,L]

###############################################
# 🧠 Enable GZIP compression (faster page loads). You can enable it in production.
###############################################
#<IfModule mod_deflate.c>
#  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json
#</IfModule>

